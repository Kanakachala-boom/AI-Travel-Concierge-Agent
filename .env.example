# Automated E-Commerce Concierge Agent - Environment Variables Example
# Copy this file to .env (or backend/.env) and configure appropriate values.

# Application Configuration
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite:///./concierge.db
# Production PostgreSQL target:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/concierge_db

# Provider Configuration
# Supported options: 'simulated' (default, offline deterministic academic simulation) or 'amadeus'
PROVIDER_MODE=simulated

# Optional: Amadeus API Credentials (required only if PROVIDER_MODE=amadeus)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
AMADEUS_TIMEOUT_SECONDS=10

# JWT Authentication & Security Settings
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
