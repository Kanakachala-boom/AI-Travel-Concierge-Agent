# ─────────────── Python ───────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
backend/venv/
backend/.venv/

# Pytest / Coverage / Caches
.pytest_cache/
