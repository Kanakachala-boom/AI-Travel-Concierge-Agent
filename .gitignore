.ruff_cache/
.coverage
htmlcov/

# Database files (generated locally — do NOT commit)
*.db
*.sqlite
*.sqlite3

# Frontend build & dependencies (Vanilla frontend in frontend/ is tracked)
node_modules/
dist/
build/
.vite/
frontend_backup/

# Environment & Secrets (Never commit actual secrets)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# IDE & Editor
.idea/
.vscode/
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Files
.DS_Store
Thumbs.db

